# Dish: read/write access to the hidraw nodes of supported gamepads.
#
# /dev/hidraw* is root-only by default. Without this file every USB-direct claim
# fails PermissionDenied and Dish keeps the pad on the SDL path, which still
# works but is rate-capped; and SDL's own HIDAPI driver, which is what drives a
# Bluetooth Sony pad's lightbar, gyro, touchpad, adaptive triggers and player
# LEDs, cannot open the pad either and SDL falls back to evdev (rumble alone).
#
# Install:  sudo install -m 644 70-dish-hidraw.rules /etc/udev/rules.d/
#           sudo udevadm control --reload-rules && sudo udevadm trigger
#
# uaccess grants the user logged in at the seat, which is what a desktop install
# wants. The `input` group fallback covers headless and non-logind sessions.

KERNEL!="hidraw*", GOTO="dish_hidraw_end"

# Sony — DualShock 4, DualSense, DualSense Edge
ATTRS{idVendor}=="054c", MODE="0660", GROUP="input", TAG+="uaccess"

# Nintendo — Switch Pro Controller
ATTRS{idVendor}=="057e", MODE="0660", GROUP="input", TAG+="uaccess"

# 8BitDo
ATTRS{idVendor}=="2dc8", MODE="0660", GROUP="input", TAG+="uaccess"

# Valve — Steam Controller (wired and dongle), and the 2026 Steam Controller
# (wired and both dongles)
ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1102", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1142", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1302", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1304", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="28de", ATTRS{idProduct}=="1305", MODE="0660", GROUP="input", TAG+="uaccess"

# PDP — wired Switch pads
ATTRS{idVendor}=="0e6f", ATTRS{idProduct}=="0180", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0e6f", ATTRS{idProduct}=="0181", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0e6f", ATTRS{idProduct}=="0184", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0e6f", ATTRS{idProduct}=="0185", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0e6f", ATTRS{idProduct}=="0187", MODE="0660", GROUP="input", TAG+="uaccess"

# Pads the bundled controller database names (assets/controllers/v1, dbVersion 1), which
# the Direct path decodes by their record's family. Only ids no line above covers.
ATTRS{idVendor}=="0738", ATTRS{idProduct}=="8250", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0738", ATTRS{idProduct}=="8384", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0738", ATTRS{idProduct}=="8480", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0738", ATTRS{idProduct}=="8481", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0c12", ATTRS{idProduct}=="0e10", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0c12", ATTRS{idProduct}=="0e15", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0c12", ATTRS{idProduct}=="0ef6", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0c12", ATTRS{idProduct}=="1cf6", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0e6f", ATTRS{idProduct}=="0207", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0e6f", ATTRS{idProduct}=="0209", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0e6f", ATTRS{idProduct}=="020a", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0f0d", ATTRS{idProduct}=="0055", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0f0d", ATTRS{idProduct}=="005c", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0f0d", ATTRS{idProduct}=="005e", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0f0d", ATTRS{idProduct}=="0066", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0f0d", ATTRS{idProduct}=="0084", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0f0d", ATTRS{idProduct}=="0087", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0f0d", ATTRS{idProduct}=="008a", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0f0d", ATTRS{idProduct}=="008c", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0f0d", ATTRS{idProduct}=="00ee", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="0f0d", ATTRS{idProduct}=="0162", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="11c0", ATTRS{idProduct}=="4001", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="146b", ATTRS{idProduct}=="0d01", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="146b", ATTRS{idProduct}=="0d02", MODE="0660", GROUP="input", TAG+="uaccess"
