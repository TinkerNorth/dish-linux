ATTRS{idVendor}=="146b", ATTRS{idProduct}=="0d09", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="146b", ATTRS{idProduct}=="0d10", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="146b", ATTRS{idProduct}=="0d13", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0401", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="1532", ATTRS{idProduct}=="1000", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="1532", ATTRS{idProduct}=="1004", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="1532", ATTRS{idProduct}=="1007", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="1532", ATTRS{idProduct}=="1008", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="1532", ATTRS{idProduct}=="100b", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="1532", ATTRS{idProduct}=="1012", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="1532", ATTRS{idProduct}=="1100", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="1532", ATTRS{idProduct}=="1200", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="20d6", ATTRS{idProduct}=="792a", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="2c22", ATTRS{idProduct}=="2000", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="2c22", ATTRS{idProduct}=="2300", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="2c22", ATTRS{idProduct}=="2500", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="3285", ATTRS{idProduct}=="0d16", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="3285", ATTRS{idProduct}=="0d17", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="3285", ATTRS{idProduct}=="0d18", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="3285", ATTRS{idProduct}=="0d19", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="7545", ATTRS{idProduct}=="0104", MODE="0660", GROUP="input", TAG+="uaccess"
ATTRS{idVendor}=="9886", ATTRS{idProduct}=="0025", MODE="0660", GROUP="input", TAG+="uaccess"

# The same vendors over Bluetooth. A Bluetooth HID device has no USB idVendor
# attribute anywhere up its chain, so the lines above never match it; its hid
# device is named <bus>:<vid>:<pid>.<n> with bus 0005 for Bluetooth, and that
# name is what these match. Dish never claims a Bluetooth pad Direct: this is
# for SDL's HIDAPI driver alone.
KERNELS=="0005:054C:*", MODE="0660", GROUP="input", TAG+="uaccess"
KERNELS=="0005:057E:*", MODE="0660", GROUP="input", TAG+="uaccess"
KERNELS=="0005:2DC8:*", MODE="0660", GROUP="input", TAG+="uaccess"

LABEL="dish_hidraw_end"
