#!/usr/bin/env bash
# Dish Linux pre-commit hook: runs clang-format (check) and clang-tidy
# (warnings → errors) on staged C++ sources. Skips gracefully if either
# tool is missing so contributors who haven't run setup-hooks.sh aren't
# blocked — CI enforces both checks in strict mode.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Collect staged C/C++ sources under src/ and tests/ (added/copied/modified).
mapfile -t staged < <(
    git diff --cached --name-only --diff-filter=ACM \
        -- 'src/*.cpp' 'src/*.h' 'src/*.hpp' 'tests/*.cpp' 'tests/*.h'
)

if [ "${#staged[@]}" -eq 0 ]; then
    exit 0
fi

format_ok=1
tidy_ok=1

# ── clang-format ─────────────────────────────────────────────────────────
if command -v clang-format >/dev/null 2>&1; then
    echo "▶ clang-format --dry-run --Werror (${#staged[@]} file(s))"
    if ! clang-format --dry-run --Werror "${staged[@]}"; then
        echo "  run: clang-format -i ${staged[*]}"
        format_ok=0
    fi
else
    echo "⚠  clang-format not installed — skipping (install clang-format)"
fi

# ── clang-tidy ───────────────────────────────────────────────────────────
# Needs a compile_commands.json. We generate one in build-debug via CMake
# (CMAKE_EXPORT_COMPILE_COMMANDS is ON in CMakeLists.txt). Match CI: report
# warnings but don't block the commit on stylistic findings — .clang-tidy's
# WarningsAsErrors='' is authoritative.
if command -v clang-tidy >/dev/null 2>&1; then
    if [ -f build-debug/compile_commands.json ]; then
        cpp_files=()
        for f in "${staged[@]}"; do
            case "$f" in
                *.cpp) cpp_files+=("$f") ;;
            esac
        done
        if [ "${#cpp_files[@]}" -gt 0 ]; then
            echo "▶ clang-tidy -p build-debug (${#cpp_files[@]} file(s))"
            clang-tidy -p build-debug --quiet "${cpp_files[@]}" || true
        fi
    else
        echo "⚠  build-debug/compile_commands.json missing — run scripts/build.sh debug"
    fi
else
    echo "⚠  clang-tidy not installed — skipping (install clang-tidy)"
fi

if [ "$format_ok" -eq 0 ] || [ "$tidy_ok" -eq 0 ]; then
    echo
    echo "✗ pre-commit failed — fix the issues above and re-stage."
    exit 1
fi
